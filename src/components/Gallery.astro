---
/**
 * Fotogalerie: Raster (.media-grid, global.css) mit Vorschaubildern (400/800 px, Lazy Loading, feste Seitenverhältnisse).
 * Ohne JavaScript öffnet ein Klick die große Version direkt; mit JavaScript die Lightbox.
 */
import type { PhotoRef } from '../lib/content';
import { photoMedia } from '../lib/media';
import { href } from '../lib/site';
import { EMPTY_IMAGE } from '../scripts/lightbox';

interface Props {
  slug: string;
  photos: PhotoRef[];
}
const { slug, photos } = Astro.props;
const items = photos.map((p) => ({ ...p, media: photoMedia(slug, p.file) }));
---

{items.length > 0 && (
  <section class="gallery" aria-labelledby="fotos-titel">
    <h2 id="fotos-titel">Fotos</h2>
    <ul id="fotos-raster" class="gallery__grid media-grid" role="list" data-gallery data-more-grid>
      {items.map((p, i) => (
        <li>
          <figure class="gallery__item">
            <a
              class="gallery__link"
              href={href(p.media.large)}
              data-lightbox-item
              data-index={i}
              data-width={p.media.width}
              data-height={p.media.height}
              data-caption={p.caption ?? ''}
              data-info={p.media.info ?? ''}
              aria-label={`Foto ${i + 1} von ${items.length} groß anzeigen: ${p.alt}`}
            >
              <img
                src={href(p.media.thumb400)}
                srcset={`${href(p.media.thumb400)} 400w, ${href(p.media.thumb800)} 800w`}
                sizes="(min-width: 1240px) 280px, (min-width: 1000px) 24vw, (min-width: 700px) 32vw, 50vw"
                width={p.media.thumbWidth}
                height={p.media.thumbHeight}
                alt={p.alt}
                loading={i < 4 ? 'eager' : 'lazy'}
                decoding="async"
              />
              {p.media.motion && (
                <video
                  class="gallery__motion"
                  data-motion
                  src={href(p.media.motion)}
                  muted
                  loop
                  playsinline
                  preload="none"
                  aria-hidden="true"
                  tabindex="-1"
                />
              )}
            </a>
          </figure>
        </li>
      ))}
    </ul>
    <button
      class="btn btn--light more-btn"
      type="button"
      aria-expanded="false"
      aria-controls="fotos-raster"
      hidden
      data-more-btn
    >
      <span data-more-label>Mehr anzeigen</span>
      <span class="visually-hidden"> (Fotos)</span>
    </button>
  </section>
)}

<dialog class="lightbox" aria-label="Foto in Großansicht" data-lightbox>
  <div class="lightbox__bar">
    <p class="lightbox__count" aria-live="polite" data-count></p>
    <button class="lightbox__btn lightbox__close" type="button" data-close autofocus>
      <span aria-hidden="true">✕</span>
      <span class="visually-hidden">Schließen</span>
    </button>
  </div>
  <figure class="lightbox__stage" data-stage>
    <div class="lightbox__photo">
      <div class="lightbox__frame">
        <img class="lightbox__img" src={EMPTY_IMAGE} alt="" data-img />
      </div>
      <div class="lightbox__info-row" data-info-row>
        <p class="lightbox__info" data-info hidden></p>
      </div>
    </div>
    <figcaption class="lightbox__caption" lang="es" data-caption hidden></figcaption>
  </figure>
  <button class="lightbox__btn lightbox__nav lightbox__prev" type="button" data-prev>
    <span aria-hidden="true">‹</span>
    <span class="visually-hidden">Vorheriges Foto</span>
  </button>
  <button class="lightbox__btn lightbox__nav lightbox__next" type="button" data-next>
    <span aria-hidden="true">›</span>
    <span class="visually-hidden">Nächstes Foto</span>
  </button>
</dialog>

<script>
  import { initLightbox } from '../scripts/lightbox';
  import { initMotion } from '../scripts/motion';
  import { initMore } from '../scripts/more';
  initLightbox();
  initMore();
  initMotion();
</script>

<style>
  .gallery {
    margin-top: 48px;
  }
  .gallery h2 {
    font-size: var(--fs-text);
  }
  .gallery__item {
    margin: 0;
    min-width: 0;
  }
  .gallery__link {
    position: relative;
    display: block;
    border: var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    background: var(--card);
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .gallery__link:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .gallery__link img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .gallery__motion {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }
  .gallery__motion {
    opacity: 0;
  }
  .gallery__motion[data-playing] {
    opacity: 1;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(43 29 22 / 0.96);
    color: var(--card);
    overscroll-behavior: contain;
  }
  .lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
  }
  .lightbox::backdrop {
    background: rgb(43 29 22 / 0.96);
  }
  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: max(8px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) 8px
      max(16px, env(safe-area-inset-left));
  }
  .lightbox__count {
    margin: 0;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .lightbox__stage {
    margin: 0;
    min-height: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 max(12px, env(safe-area-inset-right)) max(16px, env(safe-area-inset-bottom))
      max(12px, env(safe-area-inset-left));
    container-type: size;
    touch-action: pan-y pinch-zoom;
    user-select: none;
    -webkit-user-select: none;
  }
  /* Foto mit weißem Rahmen; darunter (außerhalb des Rahmens) der Kamera-Kasten, beide gleich breit */
  .lightbox__photo {
    --info-gap: 10px;
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-width: 100%;
  }
  .lightbox__frame {
    display: flex;
    flex-direction: column;
    min-height: 0;
    max-width: 100%;
    border: 2px solid var(--card);
    border-radius: 6px;
    overflow: hidden;
  }
  /* Höhe: Platz der Bühne minus Kamera-Kasten und Bildunterschrift (--reserve, misst lightbox.ts), damit
     das Foto – und damit der Kamera-Kasten darunter – nie breiter als das Foto selbst wird */
  .lightbox__img {
    display: block;
    min-height: 0;
    max-width: 100%;
    max-height: calc(100cqh - var(--reserve, 0px) - 4px);
    width: auto;
    height: auto;
    object-fit: contain;
    -webkit-user-drag: none;
  }
  /* Kameraangaben: eigener schwarzer Kasten mit weißem Rand, kleinem Abstand unter dem Rahmen des Fotos,
     zentriert und nur so breit wie sein Text, aber nie breiter als das Foto (längerer Text bricht um).
     Die Zeile ist so breit wie das Foto (width: 0 + min-width: 100%: der Text macht das Foto nie breiter). */
  .lightbox__info-row {
    display: flex;
    justify-content: center;
    box-sizing: border-box;
    width: 0;
    min-width: 100%;
  }
  .lightbox__info {
    flex: none;
    box-sizing: border-box;
    max-width: 100%;
    margin: var(--info-gap) 0 0;
    padding: 8px 12px;
    border: 1px solid var(--card);
    border-radius: 6px;
    background: #000;
    color: #fff;
    font-size: 0.9rem;
    line-height: 1.4;
    text-align: center;
    overflow-wrap: anywhere;
  }
  .lightbox__info[hidden] {
    display: none;
  }
  /* Eine Angabe (z. B. „6,8 mm (24 mm KB)“) bleibt in einer Zeile; nur wenn sie allein breiter ist
     als der Kasten, bricht sie um. Die Stücke erzeugt lightbox.ts, daher :global. */
  .lightbox__info :global(.lightbox__info-part) {
    display: inline-block;
    max-width: 100%;
  }
  /* Handy: kleinere Schrift, damit der Kasten im Verhältnis zum Foto nicht zu groß wirkt */
  @media (max-width: 699px) {
    .lightbox__info {
      padding: 4px 8px;
      font-size: 0.65rem;
      line-height: 1.35;
    }
  }
  /* Bildunterschrift (nur in der Großansicht): höchstens 30 % der Bühnenhöhe, längere Texte scrollen,
     damit das Foto nicht immer kleiner wird. Am Handy Abstand zu den Pfeilen (je 48 px + 8 px Rand). */
  .lightbox__caption {
    flex: none;
    box-sizing: border-box;
    margin: 0;
    max-width: 60ch;
    max-height: 30cqh;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--card) transparent;
    text-align: center;
    /* weicher Verlauf oben/unten, wo noch Text verborgen ist (--fade-top/-bottom setzt lightbox.ts) */
    mask-image: linear-gradient(
      to bottom,
      transparent 0,
      #000 var(--fade-top, 0px),
      #000 calc(100% - var(--fade-bottom, 0px)),
      transparent 100%
    );
  }
  @media (max-width: 699px) {
    .lightbox__caption {
      padding-inline: 44px;
    }
  }
  .lightbox__btn {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--card);
    color: var(--ink);
    font: 700 1.5rem/1 var(--font-body);
    box-shadow: 3px 3px 0 var(--ink);
    cursor: pointer;
  }
  .lightbox__btn:focus-visible {
    outline: 3px solid var(--marigold);
    outline-offset: 3px;
  }
  .lightbox__nav {
    position: absolute;
    top: var(--nav-top, 50%); /* Mitte des Fotos, setzt lightbox.ts */
    transform: translateY(-50%);
    font-size: 2rem;
  }
  .lightbox__prev {
    left: max(8px, env(safe-area-inset-left));
  }
  .lightbox__next {
    right: max(8px, env(safe-area-inset-right));
  }
  .lightbox__nav[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .gallery__link:hover {
      transform: none;
    }
  }
</style>
