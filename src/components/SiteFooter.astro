---
import { COPYRIGHT_LINE } from '../config';
---

<footer class="site-footer">
  <div class="wrap">
    <p class="whatsapp">
      <strong>Gefällt dir ein Beitrag?</strong> Reagiere in der WhatsApp-Gruppe. Dort verlinke ich
      jeden neuen Eintrag.
    </p>
    <p class="copyright">{COPYRIGHT_LINE}</p>
    <slot />
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 56px;
    padding: 28px 0 36px;
    border-top: var(--border);
    background: var(--card);
    font-size: 0.9375rem;
  }
  .whatsapp {
    max-width: 60ch;
  }
  .copyright {
    margin-bottom: 0.5em;
  }
</style>
