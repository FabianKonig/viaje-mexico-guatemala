---
import { SITE } from '../config';
---

<a class="palabrita" href={SITE.palabritaUrl} target="_blank" rel="noopener">
  <svg
    class="palabrita__art"
    viewBox="0 0 96 80"
    width="96"
    height="80"
    aria-hidden="true"
    focusable="false"
  >
    <g stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round">
      <rect
        x="22"
        y="6"
        width="62"
        height="42"
        rx="6"
        fill="var(--turquoise)"
        transform="rotate(8 53 27)"
      ></rect>
      <rect
        x="10"
        y="22"
        width="62"
        height="42"
        rx="6"
        fill="var(--card)"
        transform="rotate(-6 41 43)"
      ></rect>
    </g>
    <g transform="rotate(-6 41 43)">
      <text
        x="41"
        y="42"
        text-anchor="middle"
        font-family="Fraunces, Georgia, serif"
        font-weight="800"
        font-size="15"
        fill="var(--ink)"
      >
        hola
      </text>
      <line
        x1="24"
        y1="51"
        x2="58"
        y2="51"
        stroke="var(--terracotta)"
        stroke-width="3"
        stroke-linecap="round"
      ></line>
    </g>
  </svg>
  <span class="palabrita__text">
    <span class="palabrita__title">Kennst du schon meine Vokabellern-App?</span>
    <span class="palabrita__sub">Hier geht's zu Palabrita.</span>
  </span>
  <span class="palabrita__btn">
    Palabrita öffnen <span aria-hidden="true">→</span>
  </span>
  <span class="visually-hidden">(öffnet in einem neuen Tab)</span>
</a>

<style>
  .palabrita {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding: 22px 24px;
    background: var(--marigold);
    color: var(--ink);
    border: var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    text-decoration: none;
    transition:
      transform 0.12s ease,
      box-shadow 0.12s ease;
  }
  .palabrita:hover {
    color: var(--ink);
    transform: translate(-2px, -2px);
    box-shadow: 8px 8px 0 var(--ink);
  }
  .palabrita__art {
    flex: 0 0 auto;
    width: 84px;
    height: auto;
  }
  .palabrita__text {
    flex: 1 1 260px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .palabrita__title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: var(--fs-text);
    line-height: 1.15;
  }
  .palabrita__sub {
    font-size: var(--fs-text);
  }
  .palabrita__btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 48px;
    padding: 10px 20px;
    border: var(--border);
    border-radius: 999px;
    background: var(--ink);
    color: var(--card);
    font-weight: 700;
    white-space: nowrap;
  }
  @media (max-width: 599px) {
    .palabrita__btn {
      flex-basis: 100%;
      justify-content: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .palabrita:hover {
      transform: none;
    }
  }
</style>
