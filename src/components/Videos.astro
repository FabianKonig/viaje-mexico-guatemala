---
/**
 * Videos eines Beitrags (`clips`): selbst ausgeliefertes MP4 mit Ton. Der Browser lädt erst nach dem
 * Antippen von „Play“ (preload="none"); vorher nur das kleine Standbild. Funktioniert ohne JavaScript.
 */
import type { ClipRef } from '../lib/content';
import { clipMedia } from '../lib/media';
import { href } from '../lib/site';

interface Props {
  slug: string;
  clips: ClipRef[];
}
const { slug, clips } = Astro.props;
const clipItems = clips.map((c) => ({ ...c, media: clipMedia(slug, c.file) }));
---

{clipItems.length > 0 && (
  <section class="videos" aria-labelledby="videos-titel">
    <h2 id="videos-titel">Videos</h2>
    <ul class="videos__list" role="list">
      {clipItems.map((c) => (
        <li class="clip card">
          <video
            class="clip__video"
            controls
            playsinline
            preload="none"
            poster={href(c.media.poster)}
            width={c.width}
            height={c.height}
            aria-label={c.title}
          >
            <source src={href(c.media.src)} type="video/mp4" />
            <a href={href(c.media.src)}>Video herunterladen</a>
          </video>
          <p class="clip__title">{c.title}</p>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .videos {
    margin-top: 48px;
  }
  .videos__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 420px), 1fr));
    gap: 24px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .clip {
    overflow: hidden;
  }
  .clip__video {
    display: block;
    width: 100%;
    height: auto;
    max-height: 75vh;
    background: var(--ink);
  }
  .clip__title {
    margin: 0;
    padding: 12px 16px;
    font-size: 0.9375rem;
  }
</style>
