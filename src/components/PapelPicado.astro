---
/** Papel-Picado-Wimpelrand (eigene SVG-Illustration, dekorativ). */
---

<svg class="picado" width="100%" height="52" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="picado-tile" width="240" height="52" patternUnits="userSpaceOnUse">
      <g>
        <path
          d="M4 6 H56 V41 L49.5 49 L43 41 L36.5 49 L30 41 L23.5 49 L17 41 L10.5 49 L4 41 Z"
          fill="var(--pink)"
          stroke="var(--ink)"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <g fill="var(--sand)">
          <circle cx="16" cy="19" r="3.2" />
          <circle cx="44" cy="19" r="3.2" />
          <path d="M30 13 l6 7 -6 7 -6 -7z" />
          <circle cx="17" cy="33" r="2.2" />
          <circle cx="30" cy="34" r="2.2" />
          <circle cx="43" cy="33" r="2.2" />
        </g>
        <path
          d="M64 6 H116 V41 L109.5 49 L103 41 L96.5 49 L90 41 L83.5 49 L77 41 L70.5 49 L64 41 Z"
          fill="var(--marigold)"
          stroke="var(--ink)"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <g fill="var(--sand)">
          <circle cx="76" cy="19" r="3.2" />
          <circle cx="104" cy="19" r="3.2" />
          <path d="M90 13 l6 7 -6 7 -6 -7z" />
          <circle cx="77" cy="33" r="2.2" />
          <circle cx="90" cy="34" r="2.2" />
          <circle cx="103" cy="33" r="2.2" />
        </g>
        <path
          d="M124 6 H176 V41 L169.5 49 L163 41 L156.5 49 L150 41 L143.5 49 L137 41 L130.5 49 L124 41 Z"
          fill="var(--turquoise)"
          stroke="var(--ink)"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <g fill="var(--sand)">
          <circle cx="136" cy="19" r="3.2" />
          <circle cx="164" cy="19" r="3.2" />
          <path d="M150 13 l6 7 -6 7 -6 -7z" />
          <circle cx="137" cy="33" r="2.2" />
          <circle cx="150" cy="34" r="2.2" />
          <circle cx="163" cy="33" r="2.2" />
        </g>
        <path
          d="M184 6 H236 V41 L229.5 49 L223 41 L216.5 49 L210 41 L203.5 49 L197 41 L190.5 49 L184 41 Z"
          fill="var(--terracotta)"
          stroke="var(--ink)"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
