          <circle cx="196" cy="19" r="3.2" />
          <circle cx="224" cy="19" r="3.2" />
          <path d="M210 13 l6 7 -6 7 -6 -7z" />
          <circle cx="197" cy="33" r="2.2" />
          <circle cx="210" cy="34" r="2.2" />
          <circle cx="223" cy="33" r="2.2" />
        </g>
      </g>
      <line x1="0" y1="6" x2="240" y2="6" stroke="var(--ink)" stroke-width="2.5" />
    </pattern>
  </defs>
  <rect width="100%" height="52" fill="url(#picado-tile)"></rect>
</svg>

<style>
  .picado {
    display: block;
    width: 100%;
    height: 52px;
  }
</style>
