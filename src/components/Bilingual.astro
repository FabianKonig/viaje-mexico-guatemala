---
/**
 * Original (byte-genau) und Übersetzung untereinander (erst Original, dann Übersetzung).
 * Ohne JavaScript sind beide sichtbar; der Schalter erscheint erst mit JavaScript.
 * Lange Texte werden mit JavaScript je Kachel auf 10 Zeilen gekürzt („Weiterlesen“), der
 * ganze Text bleibt im DOM (Original byte-genau, durchsuchbar, vorlesbar).
 */
import type { Post } from '../lib/content';
import { escapeHtml } from '../lib/html';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { original, translation, translationData } = post;

// Original in Stücke zerlegen: Leerraum + Segment (mit lang), damit textContent === original.md
const originalParts: { gap: string; text: string; lang: string }[] = [];
let cursor = 0;
for (const seg of translationData.segments) {
  const idx = original.indexOf(seg.text, cursor);
  originalParts.push({ gap: original.slice(cursor, idx), text: seg.text, lang: seg.lang });
  cursor = idx + seg.text.length;
}
const tail = original.slice(cursor);
// Als fertiges HTML erzeugen (set:html), damit Formatierer keinen Leerraum einfügen können.
const span = (lang: string, text: string, attrLang = true) =>
  `<span${attrLang ? ` lang="${lang}"` : ''} data-lang="${lang}">${escapeHtml(text)}</span>`;
const originalHtml =
  originalParts.map((p) => escapeHtml(p.gap) + span(p.lang, p.text)).join('') + escapeHtml(tail);
const translationHtml = translation.paragraphs.map((para) =>
  para.map((piece) => escapeHtml(piece.sep) + span(piece.lang, piece.text, false)).join(''),
);
const showTranslation = translation.hasSpanish;
const id = `uebersetzung-${post.slug}`;
---

<div class="bilingual" data-bilingual>
  {showTranslation && (
    <button
      class="btn btn--light toggle"
      type="button"
      aria-expanded="true"
      aria-controls={id}
      hidden
      data-toggle
    >
      <span data-label>Übersetzung ausblenden</span>
    </button>
  )}
  <div class="tiles">
    <section class="tile card" aria-labelledby={`${id}-orig`}>
      <header class="tile__head">
        <h2 id={`${id}-orig`} class="tile__title">
          Original
        </h2>
        <span class="tag tag--sincorregir" lang="es">
          Mi español, sin corregir
        </span>
      </header>
      <div class="clamp" id={`${id}-orig-text`} data-clamp>
        <div
          class="original"
          data-original
          data-source-sha256={translationData.source_sha256}
          set:html={originalHtml}
        />
      </div>
      <button
        class="btn btn--light more"
        type="button"
        aria-expanded="true"
        aria-controls={`${id}-orig-text`}
        hidden
        data-more
      >
        <span data-more-label>Weiterlesen</span>
        <span class="visually-hidden"> (Original)</span>
      </button>
    </section>
    {showTranslation && (
      <section id={id} class="tile card" aria-labelledby={`${id}-de`} lang="de" data-translation>
        <header class="tile__head">
          <h2 id={`${id}-de`} class="tile__title">
            Übersetzung
          </h2>
        </header>
        <div class="clamp" id={`${id}-de-text`} data-clamp>
          {translationHtml.map((html) => (
            <p class="translation-p" set:html={html} />
          ))}
        </div>
        <button
          class="btn btn--light more"
          type="button"
          aria-expanded="true"
          aria-controls={`${id}-de-text`}
          hidden
          data-more
        >
          <span data-more-label>Weiterlesen</span>
          <span class="visually-hidden"> (Übersetzung)</span>
        </button>
      </section>
    )}
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-bilingual]')) {
    const btn = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const panel = root.querySelector<HTMLElement>('[data-translation]');
    const label = btn?.querySelector<HTMLElement>('[data-label]');
    if (!btn || !panel || !label) continue;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const show = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(show));
      panel.hidden = !show;
      label.textContent = show ? 'Übersetzung ausblenden' : 'Übersetzung einblenden';
      if (show) updateClamps();
    });
  }

  // Lange Texte kürzen: je Kachel einzeln auf- und zuklappbar.
  // Gekürzt wird nur, wenn mindestens 3 Zeilen mehr kämen als die Kurzfassung zeigt.
  // Die Zahl der sichtbaren Zeilen steht nur im Stylesheet (--shown-lines).
  const MIN_HIDDEN_LINES = 3;
  const LINE_HEIGHT = 1.65; // em, wie im Stylesheet
  const clamps = [...document.querySelectorAll<HTMLElement>('[data-clamp]')];

  function updateClamps() {
    for (const el of clamps) {
      const btn = el.parentElement?.querySelector<HTMLButtonElement>('[data-more]');
      if (!btn || el.offsetParent === null) continue; // verborgene Kachel nicht messen
      const style = getComputedStyle(el);
      const shown = Number(style.getPropertyValue('--shown-lines'));
      const lines = el.scrollHeight / (parseFloat(style.fontSize) * LINE_HEIGHT);
      if (lines <= shown + MIN_HIDDEN_LINES) {
        el.dataset.state = 'off'; // kurz genug: nichts kürzen
        btn.hidden = true;
      } else {
        // Nur zuklappen, wenn der Leser nicht schon aufgeklappt hat.
        if (el.dataset.state !== 'open') setOpen(el, btn, false);
        btn.hidden = false;
      }
    }
  }

  function setOpen(el: HTMLElement, btn: HTMLButtonElement, open: boolean) {
    el.dataset.state = open ? 'open' : 'collapsed';
    btn.setAttribute('aria-expanded', String(open));
    const label = btn.querySelector<HTMLElement>('[data-more-label]');
    if (label) label.textContent = open ? 'Weniger anzeigen' : 'Weiterlesen';
  }

  for (const el of clamps) {
    const btn = el.parentElement?.querySelector<HTMLButtonElement>('[data-more]');
    if (!btn) continue;
    // Auch ein Tipp auf den gekürzten Text klappt auf (außer beim Markieren von Text).
    el.addEventListener('click', () => {
      if (el.dataset.state === 'collapsed' && !window.getSelection()?.toString()) btn.click();
    });
    btn.addEventListener('click', () => {
      const open = el.dataset.state !== 'open';
      setOpen(el, btn, open);
      // Beim Zuklappen die Kachel wieder ins Bild holen, falls ihr Kopf oben herausgerutscht ist.
      const tile = el.closest<HTMLElement>('.tile');
      if (!open && tile && tile.getBoundingClientRect().top < 0) tile.scrollIntoView();
    });
  }

  updateClamps();
  void document.fonts?.ready.then(updateClamps);
  let frame = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(updateClamps);
  });
</script>

<style>
  .toggle {
    margin-bottom: 20px;
  }
  /* Immer untereinander (erst Original, dann Übersetzung), in Lesebreite und linksbündig */
  .tiles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    max-width: 760px;
  }
  .tile {
    min-width: 0;
    padding: 20px clamp(18px, 3vw, 28px) 24px;
  }
  .tile[hidden] {
    display: none;
  }
  .tile__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    margin-bottom: 12px;
  }
  .tile__title {
    font-size: var(--fs-text);
    margin: 0;
  }
  .tag--sincorregir {
    background: var(--marigold);
    text-transform: none;
    letter-spacing: 0;
    font-size: var(--fs-text);
  }
  .clamp {
    --shown-lines: 10;
    position: relative;
    font-size: var(--fs-text);
    line-height: 1.65;
  }
  .original,
  .translation-p {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  /* Gekürzt (nur mit JavaScript): 10 Zeilen und ein Verlauf zur Kachelfarbe. Die Kürzung gilt
     schon vor dem Skript (scripting: enabled), damit der Text beim Laden nicht aufblitzt. */
  .clamp[data-state='collapsed'] {
    cursor: pointer;
  }
  .clamp[data-state='open'] {
    cursor: auto;
  }
  @media (scripting: enabled) {
    .clamp:not([data-state='open'], [data-state='off']) {
      max-height: calc(var(--shown-lines) * 1.65em);
      overflow: hidden;
    }
  }
  .clamp[data-state='collapsed']::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3.5em;
    background: linear-gradient(to bottom, transparent, var(--card));
    pointer-events: none;
  }
  .more {
    margin-top: 14px;
    min-height: 44px;
    padding: 8px 18px;
  }
  .more[hidden] {
    display: none;
  }
  .more::after {
    content: '';
    width: 0.55em;
    height: 0.55em;
    margin-top: -0.2em;
    border: solid currentColor;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  .more[aria-expanded='true']::after {
    margin-top: 0.2em;
    transform: rotate(-135deg);
  }
  .original {
    margin: 0;
  }
  .translation-p:last-child {
    margin-bottom: 0;
  }
</style>
