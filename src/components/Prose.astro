---
/** Textseite (Impressum, Datenschutz, Lizenzhinweise) in einer Karte. */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<article class="prose wrap">
  <div class="prose__card card">
    <h1>{title}</h1>
    <slot />
  </div>
</article>

<style>
  .prose {
    margin-top: 28px;
  }
  .prose__card {
    max-width: 820px;
    padding: clamp(20px, 4vw, 40px);
  }
  .prose__card :global(h1) {
    font-size: clamp(2rem, 1.4rem + 2.5vw, 3rem);
  }
  .prose__card :global(h2) {
    font-size: 1.5rem;
    margin-top: 1.6em;
  }
  .prose__card :global(h3) {
    font-size: 1.2rem;
    margin-top: 1.2em;
  }
  .prose__card :global(address) {
    font-style: normal;
    margin-bottom: 1em;
  }
  .prose__card :global(ul) {
    padding-left: 1.2em;
  }
  .prose__card :global(li) {
    margin-bottom: 0.3em;
  }
  .prose__card :global(.note) {
    font-size: 0.9375rem;
    font-style: italic;
  }
  .prose__card :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
  }
  .prose__card :global(th),
  .prose__card :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 6px 8px;
    border-bottom: 1px solid var(--ink);
    overflow-wrap: anywhere;
  }
</style>
