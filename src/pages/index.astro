---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import PalabritaTile from '../components/PalabritaTile.astro';
import RouteMap from '../components/RouteMap.astro';
import TravelDay from '../components/TravelDay.astro';
import OlderPosts from '../components/OlderPosts.astro';
import { getContent } from '../lib/data';
import { href } from '../lib/site';

const { posts, places } = getContent();
const latest = posts[0];
// Die neuesten Beiträge stehen als Karten, alle weiteren in „Ältere Beiträge“.
const RECENT_COUNT = 6;
const recent = posts.slice(0, RECENT_COUNT);
const older = posts.slice(RECENT_COUNT);
---

<Base home>
  <section class="hero wrap" aria-label="Über dieses Reisetagebuch">
    <div class="hero__intro">
      <h2 id="ruta-titel" class="hero__map-title">
        Ruta
      </h2>
      <section id="ruta" class="hero__map card" aria-labelledby="ruta-titel">
        <RouteMap places={places} />
      </section>
      <p class="hero__badge">¡Bienvenido / Willkommen!</p>
      <div class="hero__lead">
        <p>
          ¡Hola! Schön, dass du hier bist. Dies ist mein Versuch eines Reiseblogs. Und zugleich ein
          Versuch, mein Spanisch durch Schreiben zu festigen. Mit Beiträgen mal auf Spanisch (und
          inklusive aller Anfängerfehler), aber auch mal auf Deutsch, je nach Lust und Laune. Und
          keine Sorge, falls tú no hablas español: Die deutsche Übersetzung steht immer daneben.
        </p>
        <p>
          Ich möchte hier festhalten, was ich unterwegs erlebe, und euch ein bisschen daran
          teilhaben lassen, von den kleinen Alltagsmomenten bis zu den großen Highlights.
        </p>
        <p>
          Wer mich besser kennt, weiß aber auch, dass ich nicht wirklich ein Social-Media-Typ bin.
          Von daher weiß ich noch nicht, ob ich hier wirklich regelmäßig schreiben werde. Schauen
          wir einfach mal, was die nächsten Wochen bringen werden :)
        </p>
        <p>
          ¡Viel Spaß beim Lesen und hasta pronto!
          <br />
          Fabian
        </p>
      </div>
      <div class="hero__actions">
        <TravelDay />
        {latest && (
          <a class="btn" href={href(`entradas/${latest.slug}/`)}>
            Neuesten Beitrag lesen
          </a>
        )}
      </div>
    </div>
  </section>

  <section id="entradas" class="entradas wrap" aria-labelledby="entradas-titel">
    <h2 id="entradas-titel">Entradas</h2>
    {posts.length === 0 ? (
      <p>Noch keine Beiträge. Bald geht's los!</p>
    ) : (
      <ul class="post-grid" role="list">
        {recent.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    )}
    <OlderPosts posts={older} />
  </section>

  <section class="wrap palabrita-wrap" aria-label="Vokabellern-App Palabrita">
    <PalabritaTile />
  </section>
</Base>

<style>
  #entradas-titel {
    font-size: var(--fs-title);
  }
  .hero {
    margin-top: 20px;
  }
  /* Handy: alles untereinander, die Karte steht (per order) unter Text und Knopf. */
  .hero__intro {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .hero__badge {
    order: 1;
    align-self: flex-start;
    margin: 0 0 18px;
    padding: 10px 18px;
    background: var(--marigold);
    border: var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: var(--fs-text);
    line-height: 1.15;
  }
  .hero__lead {
    order: 2;
    font-size: var(--fs-text);
    line-height: 1.5;
    max-width: 34ch;
  }
  .hero__actions {
    order: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    margin-top: 28px;
  }
  .hero__map-title {
    order: 4;
    font-size: var(--fs-title);
    margin: 40px 0 12px;
  }
  .hero__map {
    order: 5;
    min-width: 0;
    padding: clamp(10px, 3vw, 16px);
  }
  /* Ab 900px schwimmt die Karte rechts (7 von 12 Teilen, 40px Abstand). Der Text umfließt sie,
     Zeilen unterhalb der Karte laufen über die ganze Breite. */
  @media (min-width: 900px) {
    .hero__intro {
      display: flow-root;
    }
    /* Am Computer nur für Screenreader (die Karte steht neben dem Text) */
    .hero__map-title {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .hero__map {
      float: right;
      width: calc((100% - 40px) * 7 / 12);
      margin: 0 0 28px 40px;
    }
    .hero__badge {
      display: inline-block;
    }
    .hero__lead {
      max-width: none;
    }
    .hero__actions {
      margin-top: 32px;
    }
  }
  .entradas {
    margin-top: 56px;
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-grid > li {
    display: flex;
    min-width: 0;
  }
  .post-grid > li > :global(*) {
    flex: 1;
  }
  .palabrita-wrap {
    margin-top: 56px;
  }
</style>
