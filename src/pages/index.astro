---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import PalabritaTile from '../components/PalabritaTile.astro';
import RouteMap from '../components/RouteMap.astro';
import TravelDay from '../components/TravelDay.astro';
import { getContent } from '../lib/data';
import { href } from '../lib/site';

const { posts, places } = getContent();
const latest = posts[0];
---

<Base home>
  <section class="hero wrap" aria-label="Über dieses Reisetagebuch">
    <div class="hero__intro">
      <p class="hero__badge">¡Bienvenido / Willkommen!</p>
      <div class="hero__lead">
        <p>
          ¡Hola! Schön, dass du hier bist. Dies ist mein Versuch eines Reiseblogs. Und zugleich ein
          Versuch, mein Spanisch durch Schreiben zu festigen. Mit Beiträgen mal auf Spanisch (und
          inklusiver aller Anfängerfehler), aber auch mal auf Deutsch, je nach Lust und Laune. Und
          keine Sorge, falls tú no hablas español: Die deutsche Übersetzung steht immer daneben. Wer
          mich besser kennt, weiß, dass ich nicht wirklich ein Social Media Typ bin. Von daher weiß
          ich noch nicht, ob ich hier wirklich regelmäßig schreiben werde. Schauen wir einfach Mal,
          was die nächsten Wochen bringen werden :)
        </p>
        <p>
          ¡Viel Spaß beim Lesen und hasta pronto!
          <br />
          Fabian
        </p>
      </div>
      <div class="hero__actions">
        {latest && (
          <a class="btn" href={href(`entradas/${latest.slug}/`)}>
            Neuesten Beitrag lesen
          </a>
        )}
        <TravelDay />
      </div>
    </div>
    <section id="ruta" class="hero__map card" aria-labelledby="ruta-titel">
      <h2 id="ruta-titel" class="visually-hidden">
        Ruta
      </h2>
      <RouteMap places={places} />
    </section>
  </section>

  <section id="entradas" class="entradas wrap" aria-labelledby="entradas-titel">
    <h2 id="entradas-titel">Entradas</h2>
    {posts.length === 0 ? (
      <p>Noch keine Beiträge. Bald geht's los!</p>
    ) : (
      <ul class="post-grid" role="list">
        {posts.map((post) => (
          <li>
            <PostCard post={post} />
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="wrap palabrita-wrap" aria-label="Vokabellern-App Palabrita">
    <PalabritaTile />
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    margin-top: 20px;
  }
  @media (min-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 40px;
    }
  }
  .hero__intro {
    min-width: 0;
  }
  .hero__badge {
    display: inline-block;
    margin: 0 0 18px;
    padding: 10px 18px;
    background: var(--marigold);
    border: var(--border);
    border-radius: 10px;
    box-shadow: var(--shadow);
    font-family: var(--font-head);
    font-weight: 800;
    font-size: clamp(1.25rem, 0.5rem + 1.5vw, 1.75rem);
    line-height: 1.15;
  }
  .hero__lead {
    font-size: clamp(17px, 1.2vw + 12px, 24px);
    line-height: 1.5;
    max-width: 34ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 20px;
    margin-top: 28px;
  }
  @media (min-width: 900px) {
    .hero__actions {
      margin-top: 32px;
    }
  }
  .hero__map {
    min-width: 0;
    padding: clamp(10px, 3vw, 16px);
  }
  .entradas {
    margin-top: 56px;
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 28px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .post-grid > li {
    display: flex;
    min-width: 0;
  }
  .post-grid > li > :global(*) {
    flex: 1;
  }
  .palabrita-wrap {
    margin-top: 56px;
  }
</style>
