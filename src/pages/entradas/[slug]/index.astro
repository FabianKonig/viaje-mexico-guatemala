---
import Base from '../../../layouts/Base.astro';
import Bilingual from '../../../components/Bilingual.astro';
import Gallery from '../../../components/Gallery.astro';
import Videos from '../../../components/Videos.astro';
import PostNav from '../../../components/PostNav.astro';
import { getContent } from '../../../lib/data';
import type { Post } from '../../../lib/content';
import { formatDateDe } from '../../../lib/dates';
import { tripDayNumber } from '../../../lib/travelDay';
import { excerpt } from '../../../lib/translation';
import { href } from '../../../lib/site';
import { postCover } from '../../../lib/media';
import { neighbours } from '../../../lib/postNav';

export function getStaticPaths() {
  const { posts } = getContent();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post, ...neighbours(posts, post.slug) },
  }));
}

interface Props {
  post: Post;
  prev?: Post;
  next?: Post;
}
const { post, prev, next } = Astro.props;
const day = tripDayNumber(post.date);
const description = post.titleDe
  ? `${post.titleDe}: ${excerpt(post.original, 140)}`
  : excerpt(post.original, 160);
const cover = postCover(post);
const ogImage = cover?.media.og
  ? { path: cover.media.og, width: 1200, height: 630, alt: cover.alt }
  : undefined;
---

<Base title={post.title} description={description} ogImage={ogImage} ogType="article">
  <article class="post wrap" lang="de">
    <header class="post__head">
      <h1 class="post__title" lang={post.translation.languages[0]}>
        {post.title}
      </h1>
      {post.titleDe && <p class="post__title-de">{post.titleDe}</p>}
      <p class="post__meta">
        {post.place && <span lang="es">{post.place.name}</span>}
        {post.place && (
          <span class="post__sep" aria-hidden="true">
            {' '}
            ·{' '}
          </span>
        )}
        <span class="post__when">
          {day >= 1 && <span>Tag {day}</span>}
          {day >= 1 && <span aria-hidden="true"> · </span>}
          <time datetime={post.date}>{formatDateDe(post.date)}</time>
        </span>
      </p>
    </header>

    <Bilingual post={post} />

    <Gallery slug={post.slug} photos={post.photos} />

    <Videos slug={post.slug} clips={post.clips} />

    <PostNav prev={prev} next={next} />

    <p class="post__back">
      <a href={href() + '#entradas'}>
        <span aria-hidden="true">←</span> Alle Beiträge
      </a>
    </p>
  </article>
</Base>

<style>
  .post {
    margin-top: 28px;
  }
  .post__head {
    margin-bottom: 24px;
    max-width: 900px;
  }
  .post__title {
    font-size: var(--fs-title);
    font-weight: 800;
    letter-spacing: -0.01em;
    margin-bottom: 0.2em;
  }
  .post__title-de {
    font-family: var(--font-head);
    font-size: var(--fs-text);
    margin: 0 0 8px;
  }
  .post__meta {
    font-weight: 700;
    color: var(--terracotta-text);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    font-size: var(--fs-text);
    margin: 0;
  }
  .post__when time {
    white-space: nowrap;
  }
  /* Handy: Ort in der ersten, Tag und Datum immer in der zweiten Zeile */
  @media (max-width: 699px) {
    .post__sep {
      display: none;
    }
    .post__when {
      display: block;
    }
  }
  .post__back {
    margin-top: 40px;
  }
  .post__back a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    min-height: 44px;
    font-weight: 700;
  }
</style>
